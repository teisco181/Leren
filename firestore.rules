rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Security Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isNonAnonOwner(userId) {
      return isSignedIn() && !isAnonymous() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.matches('^[0-9]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBoundedMapList(listVal, maxLen) {
      return listVal is list && listVal.size() <= maxLen && (listVal.size() == 0 || listVal[0] is map);
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'themePreference', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.photoURL is string && data.photoURL.size() <= 500
        && (!('themePreference' in data) || data.themePreference in ['light', 'dark', 'system'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFolder(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'parentId', 'subject', 'color', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'parentId', 'subject', 'color', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.parentId is string && data.parentId.size() <= 128
        && data.subject is string && data.subject.size() <= 80
        && data.color is string && data.color.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudyItem(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'folderId', 'title', 'type', 'subject', 'content',
          'fileDataUrl', 'fileName', 'fileSize', 'driveFileId', 'driveUrl', 'mimeType',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'folderId', 'title', 'type', 'subject', 'content',
          'fileDataUrl', 'fileName', 'fileSize', 'driveFileId', 'driveUrl', 'mimeType',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.folderId is string && data.folderId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.type in ['note', 'pdf', 'gdoc', 'gsheet', 'gslide']
        && data.subject is string && data.subject.size() <= 80
        && data.content is string && data.content.size() <= 300000
        && data.fileDataUrl is string && data.fileDataUrl.size() <= 700000
        && data.fileName is string && data.fileName.size() <= 200
        && data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 50000000
        && data.driveFileId is string && data.driveFileId.size() <= 200
        && data.driveUrl is string && data.driveUrl.size() <= 500
        && data.mimeType is string && data.mimeType.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScheduleTask(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'subject', 'date', 'durationMinutes',
          'completed', 'notes', 'isAiGenerated', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'subject', 'date', 'durationMinutes',
          'completed', 'notes', 'isAiGenerated', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.subject is string && data.subject.size() <= 80
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 600
        && data.completed is bool
        && data.notes is string && data.notes.size() <= 1000
        && data.isAiGenerated is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSummary(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'subject', 'sourceItemId', 'sourceTitle',
          'content', 'keyTerms', 'selfTest', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'subject', 'sourceItemId', 'sourceTitle',
          'content', 'keyTerms', 'selfTest', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.subject is string && data.subject.size() <= 80
        && data.sourceItemId is string && data.sourceItemId.size() <= 128
        && data.sourceTitle is string && data.sourceTitle.size() <= 160
        && data.content is string && data.content.size() <= 200000
        && isValidBoundedMapList(data.keyTerms, 30)
        && isValidBoundedMapList(data.selfTest, 20)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudySet(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'title', 'subject', 'sourceTitle',
          'flashcards', 'pairs', 'questions', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'subject', 'sourceTitle',
          'flashcards', 'pairs', 'questions', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.subject is string && data.subject.size() <= 80
        && data.sourceTitle is string && data.sourceTitle.size() <= 160
        && isValidBoundedMapList(data.flashcards, 40)
        && isValidBoundedMapList(data.pairs, 30)
        && isValidBoundedMapList(data.questions, 30)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExternalTool(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'url', 'subjectLabel', 'color', 'iconName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'url', 'subjectLabel', 'color', 'iconName', 'createdAt', 'updatedAt'])
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 500
        && data.subjectLabel is string && data.subjectLabel.size() <= 80
        && data.color is string && data.color.size() <= 30
        && data.iconName is string && data.iconName.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGameRoom(data, roomCode) {
      return data.keys().hasAll([
          'roomCode', 'hostId', 'hostName', 'title', 'gameMode', 'status',
          'currentQuestionIndex', 'questionStartedAt', 'questions', 'pairs',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomCode', 'hostId', 'hostName', 'title', 'gameMode', 'status',
          'currentQuestionIndex', 'questionStartedAt', 'questions', 'pairs',
          'createdAt', 'updatedAt'
        ])
        && data.roomCode == roomCode
        && isValidRoomCode(data.roomCode)
        && isValidId(data.hostId)
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.gameMode in ['quiz', 'speed-match']
        && data.status in ['lobby', 'question', 'leaderboard', 'finished']
        && data.currentQuestionIndex is int && data.currentQuestionIndex >= 0 && data.currentQuestionIndex <= 50
        && data.questionStartedAt is number && data.questionStartedAt >= 0
        && isValidBoundedMapList(data.questions, 30)
        && isValidBoundedMapList(data.pairs, 20)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGamePlayer(data, playerId) {
      return data.keys().hasAll([
          'uid', 'nickname', 'avatar', 'score', 'streak',
          'lastAnswerIndex', 'lastAnswerCorrect', 'lastAnsweredQuestion', 'lastPointsEarned',
          'joinedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'nickname', 'avatar', 'score', 'streak',
          'lastAnswerIndex', 'lastAnswerCorrect', 'lastAnsweredQuestion', 'lastPointsEarned',
          'joinedAt', 'updatedAt'
        ])
        && data.uid == playerId
        && isValidId(data.uid)
        && data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 24
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 20
        && data.score is int && data.score >= 0 && data.score <= 1000000
        && data.streak is int && data.streak >= 0 && data.streak <= 100
        && data.lastAnswerIndex is int && data.lastAnswerIndex >= -1 && data.lastAnswerIndex <= 20
        && data.lastAnswerCorrect is bool
        && data.lastAnsweredQuestion is int && data.lastAnsweredQuestion >= -1 && data.lastAnsweredQuestion <= 50
        && data.lastPointsEarned is int && data.lastPointsEarned >= 0 && data.lastPointsEarned <= 50000
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- User Isolated Data ---
    match /users/{userId} {
      allow get: if isNonAnonOwner(userId) && isValidId(userId);
      allow create: if isNonAnonOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isNonAnonOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'themePreference', 'updatedAt']);
      allow delete: if isNonAnonOwner(userId) && isValidId(userId);

      match /folders/{folderId} {
        allow get: if isNonAnonOwner(userId) && isValidId(folderId);
        allow list: if isNonAnonOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isNonAnonOwner(userId)
          && isValidId(folderId)
          && isValidFolder(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isNonAnonOwner(userId)
          && isValidId(folderId)
          && isValidFolder(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'parentId', 'subject', 'color', 'updatedAt']);
        allow delete: if isNonAnonOwner(userId) && isValidId(folderId);
      }

      match /items/{itemId} {
        allow get: if isNonAnonOwner(userId) && isValidId(itemId);
        allow list: if isNonAnonOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isNonAnonOwner(userId)
          && isValidId(itemId)
          && isValidStudyItem(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isNonAnonOwner(userId)
          && isValidId(itemId)
          && isValidStudyItem(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'folderId', 'title', 'subject', 'content', 'fileDataUrl',
            'fileName', 'fileSize', 'driveFileId', 'driveUrl', 'mimeType', 'updatedAt'
          ]);
        allow delete: if isNonAnonOwner(userId) && isValidId(itemId);
      }

      match /scheduleTasks/{taskId} {
        allow get: if isNonAnonOwner(userId) && isValidId(taskId);
        allow list: if isNonAnonOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isNonAnonOwner(userId)
          && isValidId(taskId)
          && isValidScheduleTask(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isNonAnonOwner(userId)
          && isValidId(taskId)
          && isValidScheduleTask(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'subject', 'date', 'durationMinutes', 'completed', 'notes', 'updatedAt'
          ]);
        allow delete: if isNonAnonOwner(userId) && isValidId(taskId);
      }

      match /summaries/{summaryId} {
        allow get: if isNonAnonOwner(userId) && isValidId(summaryId);
        allow list: if isNonAnonOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isNonAnonOwner(userId)
          && isValidId(summaryId)
          && isValidSummary(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isNonAnonOwner(userId)
          && isValidId(summaryId)
          && isValidSummary(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'subject', 'sourceItemId', 'sourceTitle', 'content', 'keyTerms', 'selfTest', 'updatedAt'
          ]);
        allow delete: if isNonAnonOwner(userId) && isValidId(summaryId);
      }

      match /studySets/{setId} {
        allow get: if isNonAnonOwner(userId) && isValidId(setId);
        allow list: if isNonAnonOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isNonAnonOwner(userId)
          && isValidId(setId)
          && isValidStudySet(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isNonAnonOwner(userId)
          && isValidId(setId)
          && isValidStudySet(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'subject', 'flashcards', 'pairs', 'questions', 'updatedAt'
          ]);
        allow delete: if isNonAnonOwner(userId) && isValidId(setId);
      }

      match /externalTools/{toolId} {
        allow get: if isNonAnonOwner(userId) && isValidId(toolId);
        allow list: if isNonAnonOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isNonAnonOwner(userId)
          && isValidId(toolId)
          && isValidExternalTool(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isNonAnonOwner(userId)
          && isValidId(toolId)
          && isValidExternalTool(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'url', 'subjectLabel', 'color', 'iconName', 'updatedAt'
          ]);
        allow delete: if isNonAnonOwner(userId) && isValidId(toolId);
      }
    }

    // --- Real-Time Multiplayer Game Rooms ---
    match /gameRooms/{roomCode} {
      // Only direct GET by exact 6-digit code; no LIST scraping
      allow get: if isSignedIn() && isValidRoomCode(roomCode);
      allow create: if isSignedIn() && !isAnonymous()
        && isValidRoomCode(roomCode)
        && isValidGameRoom(incoming(), roomCode)
        && incoming().hostId == request.auth.uid
        && incoming().status == 'lobby'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && !isAnonymous()
        && isValidRoomCode(roomCode)
        && isValidGameRoom(incoming(), roomCode)
        && existing().hostId == request.auth.uid
        && existing().status != 'finished'
        && incoming().roomCode == existing().roomCode
        && incoming().hostId == existing().hostId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'currentQuestionIndex', 'questionStartedAt', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidRoomCode(roomCode) && existing().hostId == request.auth.uid;

      match /players/{playerId} {
        allow get: if isSignedIn() && isValidRoomCode(roomCode) && isValidId(playerId);
        allow list: if isSignedIn() && isValidRoomCode(roomCode);
        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(playerId)
          && playerId == request.auth.uid
          && isValidGamePlayer(incoming(), playerId)
          && incoming().score == 0
          && incoming().streak == 0
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/gameRooms/$(roomCode))
          && get(/databases/$(database)/documents/gameRooms/$(roomCode)).data.status == 'lobby';
        allow update: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(playerId)
          && playerId == request.auth.uid
          && isValidGamePlayer(incoming(), playerId)
          && incoming().uid == existing().uid
          && incoming().nickname == existing().nickname
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'score', 'streak', 'lastAnswerIndex', 'lastAnswerCorrect',
            'lastAnsweredQuestion', 'lastPointsEarned', 'updatedAt'
          ]);
        allow delete: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(playerId)
          && (
            playerId == request.auth.uid
            || get(/databases/$(database)/documents/gameRooms/$(roomCode)).data.hostId == request.auth.uid
          );
      }
    }
  }
}
